[gd_scene load_steps=6 format=3]

[ext_resource type="PackedScene" path="res://features/场景预览/近景游玩预览.tscn" id="game"]
[ext_resource type="Script" path="res://features/tutorial_intro/story_game.gd" id="script"]
[ext_resource type="Script" path="res://features/tutorial_intro/story_restoration.gd" id="restoration"]
[ext_resource type="PackedScene" path="res://features/tutorial_intro/story_flow.tscn" id="story"]
[ext_resource type="Script" path="res://scripts/save_session.gd" id="save"]

[node name="Game" instance=ExtResource("game")]
script = ExtResource("script")
start_in_overview = true

[node name="PlanetRestoration" parent="."]
script = ExtResource("restoration")

[node name="VictoryMeteorPresentation" parent="."]
wait_for_story = true

[node name="StoryFlow" parent="." node_paths=PackedStringArray("game", "restoration") instance=ExtResource("story")]
game = NodePath("..")
restoration = NodePath("../PlanetRestoration")

[node name="SaveSession" type="Node" parent="." node_paths=PackedStringArray("game", "story", "restoration", "discovery")]
script = ExtResource("save")
game = NodePath("..")
story = NodePath("../StoryFlow")
restoration = NodePath("../PlanetRestoration")
discovery = NodePath("../NestDiscoveryPresentation")
